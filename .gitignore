node_modules
.pnpm-store

# Production & Build outputs
dist
dist-ssr
/src-tauri/target
/src-tauri/binaries/ffmpeg
/src-tauri/binaries/yt-dlp*
/src-tauri/binaries/gallery-dl*
/src-tauri/binaries/spotiflac*
/src-tauri/gen

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

